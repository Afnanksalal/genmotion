{
  "name": "genmotion",
  "version": "1.7.0",
  "description": "Agent-native deterministic motion design engine with a curated taste system.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "genmotion": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "docs",
    "skills",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "test": "npm run build && vitest run",
    "test:studio-e2e": "playwright test",
    "test:coverage": "npm run build && vitest run --coverage",
    "lint": "eslint src tests --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run lint && npm run typecheck && npm test",
    "benchmark": "node dist/cli.js benchmark tests/fixtures/basic --frames 60",
    "prepare": "npm run build",
    "prepack": "npm run check"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "@radix-ui/colors": "^3.0.0",
    "commander": "^14.0.0",
    "express": "^5.1.0",
    "pino": "^9.9.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.34.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  }
}
